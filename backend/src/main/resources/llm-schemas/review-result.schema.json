{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "契约来源: TestCaseReviewAgent 评审解析（v8.6.2 任务 9.6）。status 枚举与评审链路实际取值一致（asText 默认 fix、reject 分级带）",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["index", "status"],
    "properties": {
      "index": { "type": "integer", "minimum": 0 },
      "status": { "enum": ["pass", "fix", "reject"] },
      "issues": { "type": "array", "items": { "type": "string" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "coverageRefs": { "type": "object" },
      "suggestedChanges": { "type": ["object", "null"] }
    }
  }
}

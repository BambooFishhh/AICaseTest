{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "契约来源: StateMachineAgent.extract（v8.6.2 任务 9.6）。transitions.items 必填 from/to——为 validateTransitions 的确定性校验前置结构保证；states 元素可为字符串或 {code,label} 对象故不约束 items",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "states", "transitions"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "states": { "type": "array" },
      "transitions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "trigger": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "uid": "aicasetest-slo",
  "title": "AICaseTest SLO",
  "tags": ["aicasetest"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (rps)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(aicasetest_http_requests_total[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx Error Ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(aicasetest_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(aicasetest_http_requests_total[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 Latency (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aicasetest_http_requests_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue Backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "aicasetest_queue_queued", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Backend Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "process_uptime_seconds", "refId": "A" }
      ]
    }
  ]
}

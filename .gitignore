# 敏感信息
.env

# Maven 本地仓库缓存
.m2-repo/

# 构建产物
backend/target/
frontend/dist/
*.class

# 数据库文件
*.db
*.db-shm
*.db-wal
*.mv.db
*.lock.db

# Node 依赖
node_modules/

# IDE
.idea/
*.iml
.vscode/

# 日志
*.log

# 运行时输出（截图/录屏/证据）
backend/outputs/
frontend/coverage/

# 根目录运行时产物（导出/证据/录屏/SSE 验证残留；已跟踪的历史导出不受影响）
/outputs/
# 运行数据目录（H2 库、git 克隆仓库等）
/data/
# AI 检查/演练临时目录
/.tmp-*/

# vP1: TLS 证书（私钥不入库）
certs/

# vP2: 本地备份产物
backups/

# LLM（v6.0: 同时映射到 Spring AI OpenAI starter 与保留的 vision MCP）
# Spring AI 读取：spring.ai.openai.api-key / base-url / chat.options.model / embedding.options.model
LLM_PROVIDER=bailian
LLM_MODEL=mimo-v2.5
# 必填：阿里百炼兼容接口的 API Key
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
# v7.10(L3): thinking 三项均为咨询性配置——Spring AI OpenAI starter 无法透传 enable_thinking，
# 开启后不生效（后端启动时会输出 warn 日志提醒）；LLM_ENABLE_THINKING 仅对 MCP 多模态链路有意义
LLM_ENABLE_THINKING=false
LLM_THINKING_ANALYSIS=false
LLM_THINKING_GENERATION=false
# embedding 独立端点与 key（chat 仍走 LLM_BASE_URL / LLM_API_KEY）
# v7.14(E17): 默认走 DashScope 兼容端点 + text-embedding-v4（1024 维，与 Milvus 默认一致）；
# 留空则用 application.yml 默认值，key 缺省回落 DASHSCOPE_API_KEY / LLM_API_KEY
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=text-embedding-v4
# v6.5: LLM 重试次数（分类 + 抖动，4xx 不重试）
LLM_RETRY_MAX_ATTEMPTS=3
# v8.6.2(9.7): LLM 出参契约灰度——observe 仅告警放行（默认），enforce 校验失败重试一次后阻断
# 切换判据：observe 期 violation 率 < 1% 且全部可解释
LLM_SCHEMA_MODE=observe
# v6.1 (B 方案): 统一 prompt 上限与 LLM HTTP 超时
LLM_MAX_PROMPT_CHARS=300000
LLM_MAX_CONTEXT_CHARS=24000
LLM_CONNECT_TIMEOUT_MS=30000
LLM_READ_TIMEOUT_MS=600000

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=aicasetest
MYSQL_USERNAME=aicasetest
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_PORT=3308

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PORT=6379

# Milvus
MILVUS_PORT=19530
MILVUS_DIMENSION=1024
MILVUS_AUTH_ENABLED=true
MILVUS_ROOT_PASSWORD=replace-with-strong-milvus-password
MILVUS_USERNAME=root

# RAG（v6.4：切片与多路检索）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=150
RAG_RRF_K=60
RAG_CONTEXT_TOPK=6
RAG_FAILURE_TOPK=3
RAG_MAX_QUERIES=12

# App
APP_ENFORCE_SECURITY=true
# v8.5: 以下键必填，缺失后端启动失败（SecurityKeyGuard 全 profile 校验）：
# APP_JWT_SECRET / APP_ADMIN_PASSWORD / MCP_BRIDGE_TOKEN / 上方 Milvus 段的 MILVUS_PASSWORD
# APP_JWT_SECRET 上线前替换为至少 32 字符随机值
APP_JWT_SECRET=change-this-secret
APP_ADMIN_PASSWORD=replace-with-strong-admin-password
MCP_BRIDGE_TOKEN=replace-with-strong-mcp-token
# v8.5: /api/mcp/** 额外来源白名单（逗号分隔 IP），默认仅回环；反代部署时配置
# APP_MCP_ALLOWED_REMOTE_ADDRS=
APP_REDIS_ENABLED=true
APP_MILVUS_ENABLED=true
APP_MCP_ENABLED=true
RETENTION_EXECUTION_DAYS=0
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5

# vP1: 上传限制（Nginx + Spring multipart + 后端二次校验）
MAX_UPLOAD_SIZE=20MB
MAX_UPLOAD_REQUEST_SIZE=20MB
MAX_UPLOAD_SIZE_BYTES=20971520

# Git URL 项目克隆目录与超时
GIT_CLONE_DIR=data/git-repos
GIT_CLONE_TIMEOUT_SECONDS=600

# vP3: Prometheus / Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# vP4: 发布部署（deploy.ps1 会覆盖 IMAGE_BACKEND/IMAGE_FRONTEND/PULL_POLICY）
IMAGE_TAG=latest
PULL_POLICY=missing

# vP5: 线程池与队列调优
EXECUTOR_ANALYSIS_CORE=2
EXECUTOR_ANALYSIS_MAX=6
EXECUTOR_ANALYSIS_QUEUE=50
EXECUTOR_GENERATION_CORE=2
EXECUTOR_GENERATION_MAX=6
EXECUTOR_GENERATION_QUEUE=50
EXECUTOR_EXECUTION_CORE=4
EXECUTOR_EXECUTION_MAX=12
EXECUTOR_EXECUTION_QUEUE=500
EXECUTOR_SEMANTIC_CORE=1
EXECUTOR_SEMANTIC_MAX=2
EXECUTOR_SEMANTIC_QUEUE=100
EXECUTOR_LLM_CONCURRENCY=8
EXECUTOR_KEEP_ALIVE_SECONDS=60
EXECUTOR_AWAIT_TERMINATION_SECONDS=30
PROJECT_EXECUTION_MAX=5

# v5.13fix: SSE 长连接超时（分钟），生成/分析 LLM 可能超过 5 分钟
APP_SSE_TIMEOUT_MINUTES=30
# v6.5: 高可用任务租约（秒），到期未心跳的任务会在启动/定时恢复时标记 NEEDS_REVIEW
APP_HA_TASK_LEASE_SECONDS=600
# v6.6: 任务 TTL 与 QUEUED 兜底调度
APP_HA_TASK_TTL_MINUTES=60
APP_HA_TTL_CRON=0 */10 * * * *
APP_HA_DISPATCH_DELAY_MS=15000
# v6.6: MCP 工具请求超时（秒），超时抛 TOOL_TIMEOUT 并支持幂等工具重试
APP_MCP_REQUEST_TIMEOUT_SECONDS=60
# v6.7: LLM provider 熔断（连续失败阈值/短路秒数）
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=30
